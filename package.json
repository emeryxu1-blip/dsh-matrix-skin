{
  "name": "dsh-matrix-skin",
  "version": "0.1.1",
  "description": "Black-first Matrix hacker skin for DeepSeek Harness (DSH) Web with efficient displayed-text code rain and readable provider reasoning.",
  "homepage": "https://github.com/emeryxu1-blip/dsh-matrix-skin#readme",
  "author": "Gavin Xu",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-skin",
    "matrix",
    "matrix-rain",
    "hacker-theme",
    "web-ui",
    "theme",
    "skin",
    "reasoning",
    "ai-agents"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./styles.css": "./styles/matrix.css",
    "./package.json": "./package.json"
  },
  "files": ["lib", "styles", "cordis.patch.yml", "README.md", "README.zh.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/client.js"
  },
  "repository": { "type": "git", "url": "git+https://github.com/emeryxu1-blip/dsh-matrix-skin.git" },
  "bugs": { "url": "https://github.com/emeryxu1-blip/dsh-matrix-skin/issues" },
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-conversation"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6"
  }
}
